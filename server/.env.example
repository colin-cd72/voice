# Copy to .env and fill in
PORT=5180
NODE_ENV=production

# ElevenLabs API key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Admin password (plaintext - hashed at boot). Used to log into /admin.
ADMIN_PASSWORD=changeme

# Session secret - any long random string
SESSION_SECRET=replace-with-long-random-string

# Where SQLite db + cached audio live (relative to server/ or absolute)
DATA_DIR=./data

# Default model for generation
ELEVENLABS_MODEL=eleven_multilingual_v2
